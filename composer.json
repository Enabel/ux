{
    "name": "enabel/ux",
    "description": "Delightful ux components for Symfony",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Damien LAGAE",
            "email": "damien.lagae@enabel.be"
        },
        {
            "name": "Gerry VANDERMAESEN",
            "email": "gerry.vandermaesen@enabel.be"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/http-foundation": "^8.0",
        "symfony/options-resolver": "^8.0",
        "symfony/ux-icons": "^2.30 || ^3.0",
        "symfony/ux-twig-component": "^2.30 || ^3.0",
        "twig/intl-extra": "^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "babdev/pagerfanta-bundle": "^4.5",
        "ergebnis/composer-normalize": "^2.48",
        "pagerfanta/twig": "^4.7",
        "phpunit/phpunit": "^13.0",
        "symfony/css-selector": "^8.0",
        "symfony/dom-crawler": "^8.0",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-csrf": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "suggest": {
        "babdev/pagerfanta-bundle": "Required, with pagerfanta/twig, by the Table component (pagination) and Enabel\\Ux\\Admin\\Pager",
        "pagerfanta/twig": "Required by the Table component: the pagerfanta() Twig function and the Bootstrap 5 template",
        "symfony/asset-mapper": "Allows to manage frontend assets more easily. Required by the admin Sidebar stylesheet (enabel-ux-admin.css).",
        "symfony/form": "Required by the FilterBar component",
        "symfony/security-csrf": "Required by the ConfirmAction component (csrf_token()) and Enabel\\Ux\\Admin\\CsrfGuard",
        "symfony/translation": "Required to translate the flash messages of the AdminLayout component (trans filter)"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Enabel\\Ux\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Enabel\\Ux\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "tools:run": [
            "@tools:run:php-cs-fixer",
            "@tools:run:phpstan"
        ],
        "tools:run:php-cs-fixer": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "tools:run:phpstan": "tools/phpstan/vendor/bin/phpstan --memory-limit=1G",
        "tools:upgrade": [
            "@tools:upgrade:php-cs-fixer",
            "@tools:upgrade:phpstan"
        ],
        "tools:upgrade:php-cs-fixer": "composer upgrade -W -d tools/php-cs-fixer",
        "tools:upgrade:phpstan": "composer upgrade -W -d tools/phpstan"
    }
}
