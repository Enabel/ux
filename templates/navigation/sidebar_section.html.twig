{# SidebarSection component: a labelled group of SidebarItem #}
<li {{ attributes.defaults({class: 'enabel-ux-sidebar-group'}) }}>
    <span id="{{ id }}" class="enabel-ux-sidebar-section">{{ label }}</span>
    <ul class="enabel-ux-sidebar-list" aria-labelledby="{{ id }}">
        {% block content %}
        {% endblock %}
    </ul>
</li>
