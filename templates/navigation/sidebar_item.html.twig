{# SidebarItem component #}
<li {{ attributes }}>
    <a class="enabel-ux-sidebar-link{% if active %} active{% endif %}" href="{{ link }}"{% if active %} aria-current="page"{% endif %}>
        {% if icon %}
            <twig:ux:icon name="{{ icon }}" style="width: 1.2rem; height: 1.2rem;" />
        {% endif %}
        <span>{{ label }}</span>
    </a>
</li>
