{# This component renders a <form>: never nest it inside another <form> (the browser would drop the inner tag and the confirm button would submit the outer form) #}
{# Button opening a confirmation modal; the form inside sends a plain POST with a CSRF token #}
<button type="button" class="btn btn-{{ variant }}{{ size == 'sm' ? ' btn-sm' : '' }}" data-bs-toggle="modal" data-bs-target="#{{ modalId }}">
    {% if icon %}<twig:ux:icon name="{{ icon }}" style="width: 1.2rem; height: 1.2rem;" /> {% endif %}{{ label }}
</button>

<div class="modal fade" id="{{ modalId }}" tabindex="-1" aria-labelledby="{{ modalId }}-title" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" method="post" action="{{ url }}">
            <input type="hidden" name="_token" value="{{ csrf_token(tokenId) }}">
            <div class="modal-header">
                <h5 class="modal-title" id="{{ modalId }}-title">{{ title }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'enabel_ux.confirm_action.cancel' | trans }}"></button>
            </div>
            <div class="modal-body">{{ message }}</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'enabel_ux.confirm_action.cancel' | trans }}</button>
                <button type="submit" class="btn btn-{{ variant }}">{{ confirmLabel }}</button>
            </div>
        </form>
    </div>
</div>
